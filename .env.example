# === Application ===
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# === Server ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# === Database (MySQL) ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_db
DB_USERNAME=root
DB_PASSWORD=change-me

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# === JWT ===
JWT_SECRET=ChangeThisJwtSecretBeforeProductionUse_AtLeast32CharsLong
JWT_EXPIRATION=86400000

# === MinIO (optional) ===
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=education-files

# === Local file storage ===
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# === AI / Vector store ===
AI_ENABLED=true
VECTOR_STORE=chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=data/chroma

# === LLM (choose at least one) ===
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite4.1:8b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4

# Alibaba Cloud / 通义千问
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-max
