# ============================================
# 智慧教育管理系统 - 环境变量配置模板
# 复制为 .env 并填入实际值
# ============================================

# --- 数据库 ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_db
DB_USERNAME=root
DB_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- JWT ---
JWT_SECRET=ChangeThisJwtSecretBeforeProductionUse_AtLeast32CharsLong
JWT_EXPIRATION=86400000

# --- MinIO (可选，不使用可留空) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=education-files

# --- LLM API (任选一个配置) ---
# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4

# 通义千问 (DashScope)
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_MODEL=qwen-max

# --- 服务器 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
